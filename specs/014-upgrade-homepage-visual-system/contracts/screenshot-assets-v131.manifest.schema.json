{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://busiscoming.local/specs/014/screenshot-assets-v131.manifest.schema.json",
  "title": "BusIsComing Homepage v1.3.1 Screenshot Assets",
  "description": "五故事使用的批准源图与 Web 衍生素材 manifest；不允许本地工程或临时目录路径。",
  "type": "object",
  "required": ["schemaVersion", "appVersion", "approvedAt", "assets"],
  "properties": {
    "schemaVersion": { "const": "2.0.0" },
    "appVersion": { "const": "1.3.1" },
    "approvedAt": { "type": "string", "format": "date" },
    "assets": {
      "type": "array",
      "minItems": 5,
      "maxItems": 5,
      "prefixItems": [
        { "$ref": "#/$defs/routeSearchAsset" },
        { "$ref": "#/$defs/savedJourneysAsset" },
        { "$ref": "#/$defs/journeyGuidanceAsset" },
        { "$ref": "#/$defs/crossOperatorArrivalsAsset" },
        { "$ref": "#/$defs/predepartureMonitorAsset" }
      ],
      "items": false
    }
  },
  "additionalProperties": false,
  "$defs": {
    "localizedString": {
      "type": "object",
      "required": ["zh-Hant", "zh-Hans", "en"],
      "properties": {
        "zh-Hant": { "type": "string", "minLength": 1 },
        "zh-Hans": { "type": "string", "minLength": 1 },
        "en": { "type": "string", "minLength": 1 }
      },
      "additionalProperties": false
    },
    "sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "managedPath": {
      "type": "string",
      "pattern": "^frontend/src/assets/app-screenshots/real/[A-Za-z0-9._/-]+\\.(png|webp|avif)$"
    },
    "output": {
      "type": "object",
      "required": ["assetPath", "width", "height", "format", "sizeBytes", "sha256"],
      "properties": {
        "assetPath": { "$ref": "#/$defs/managedPath" },
        "width": { "type": "integer", "minimum": 1 },
        "height": { "type": "integer", "minimum": 1 },
        "format": { "enum": ["png", "webp", "avif"] },
        "sizeBytes": { "type": "integer", "minimum": 1 },
        "sha256": { "$ref": "#/$defs/sha256" }
      },
      "additionalProperties": false
    },
    "asset": {
      "type": "object",
      "required": [
        "id",
        "storyId",
        "order",
        "sourceFingerprint",
        "outputs",
        "approvalStatus",
        "desensitizationStatus",
        "redactedItems",
        "retainedItems",
        "alt",
        "approvedAt",
        "provenanceLabel"
      ],
      "properties": {
        "id": { "type": "string" },
        "storyId": { "type": "string" },
        "order": { "type": "integer", "minimum": 1, "maximum": 5 },
        "sourceFingerprint": {
          "type": "object",
          "required": ["width", "height", "sha256"],
          "properties": {
            "width": { "type": "integer", "minimum": 1 },
            "height": { "type": "integer", "minimum": 1 },
            "sha256": { "$ref": "#/$defs/sha256" }
          },
          "additionalProperties": false
        },
        "outputs": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/output" }
        },
        "approvalStatus": { "const": "approved" },
        "desensitizationStatus": { "const": "approved" },
        "redactedItems": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 }
        },
        "retainedItems": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 }
        },
        "alt": { "$ref": "#/$defs/localizedString" },
        "approvedAt": { "type": "string", "format": "date" },
        "provenanceLabel": {
          "type": "string",
          "minLength": 1,
          "pattern": "^(?!.*(?:/Users/|/private/var/|AndroidStudioProjects|sourcePath)).+$"
        }
      },
      "additionalProperties": false
    },
    "routeSearchAsset": {
      "allOf": [
        { "$ref": "#/$defs/asset" },
        { "type": "object", "properties": { "id": { "const": "route-search" }, "storyId": { "const": "route-search" }, "order": { "const": 1 } } }
      ]
    },
    "savedJourneysAsset": {
      "allOf": [
        { "$ref": "#/$defs/asset" },
        { "type": "object", "properties": { "id": { "const": "saved-journeys" }, "storyId": { "const": "saved-journeys" }, "order": { "const": 2 } } }
      ]
    },
    "journeyGuidanceAsset": {
      "allOf": [
        { "$ref": "#/$defs/asset" },
        { "type": "object", "properties": { "id": { "const": "journey-guidance" }, "storyId": { "const": "journey-guidance" }, "order": { "const": 3 } } }
      ]
    },
    "crossOperatorArrivalsAsset": {
      "allOf": [
        { "$ref": "#/$defs/asset" },
        { "type": "object", "properties": { "id": { "const": "cross-operator-arrivals" }, "storyId": { "const": "cross-operator-arrivals" }, "order": { "const": 4 } } }
      ]
    },
    "predepartureMonitorAsset": {
      "allOf": [
        { "$ref": "#/$defs/asset" },
        { "type": "object", "properties": { "id": { "const": "predeparture-monitor" }, "storyId": { "const": "predeparture-monitor" }, "order": { "const": 5 } } }
      ]
    }
  }
}
