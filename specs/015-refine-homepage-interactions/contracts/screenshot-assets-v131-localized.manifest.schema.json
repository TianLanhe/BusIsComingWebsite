{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://busiscoming.local/specs/015/screenshot-assets-v131-localized.manifest.schema.json",
  "title": "BusIsComing v1.3.1 Localized Homepage Screenshot Manifest",
  "description": "五故事中文与英文截图的批准来源、响应式 WebP 输出和本地化映射合同。",
  "type": "object",
  "required": ["schemaVersion", "appVersion", "approvedAt", "localeVariantByLocale", "assets"],
  "properties": {
    "schemaVersion": { "const": "3.0.0" },
    "appVersion": { "const": "1.3.1" },
    "approvedAt": { "type": "string", "format": "date" },
    "localeVariantByLocale": {
      "type": "object",
      "required": ["zh-Hant", "zh-Hans", "en"],
      "properties": {
        "zh-Hant": { "const": "zh" },
        "zh-Hans": { "const": "zh" },
        "en": { "const": "en" }
      },
      "additionalProperties": false
    },
    "assets": {
      "type": "array",
      "minItems": 5,
      "maxItems": 5,
      "prefixItems": [
        { "$ref": "#/$defs/routeSearchAsset" },
        { "$ref": "#/$defs/savedJourneysAsset" },
        { "$ref": "#/$defs/journeyGuidanceAsset" },
        { "$ref": "#/$defs/crossOperatorArrivalsAsset" },
        { "$ref": "#/$defs/predepartureMonitorAsset" }
      ],
      "items": false
    }
  },
  "additionalProperties": false,
  "$defs": {
    "localizedString": {
      "type": "object",
      "required": ["zh-Hant", "zh-Hans", "en"],
      "properties": {
        "zh-Hant": { "type": "string", "minLength": 1 },
        "zh-Hans": { "type": "string", "minLength": 1 },
        "en": { "type": "string", "minLength": 1 }
      },
      "additionalProperties": false
    },
    "safeText": {
      "type": "string",
      "minLength": 1,
      "pattern": "^(?!.*(?:/Users/|/private/var/|AndroidStudioProjects|sourcePath)).+$"
    },
    "sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "sourceFingerprint": {
      "type": "object",
      "required": ["width", "height", "sha256"],
      "properties": {
        "width": { "const": 1080 },
        "height": { "const": 1920 },
        "sha256": { "$ref": "#/$defs/sha256" }
      },
      "additionalProperties": false
    },
    "output540": {
      "allOf": [
        { "$ref": "#/$defs/output" },
        { "type": "object", "properties": { "width": { "const": 540 }, "height": { "const": 960 } } }
      ]
    },
    "output720": {
      "allOf": [
        { "$ref": "#/$defs/output" },
        { "type": "object", "properties": { "width": { "const": 720 }, "height": { "const": 1280 } } }
      ]
    },
    "output1080": {
      "allOf": [
        { "$ref": "#/$defs/output" },
        { "type": "object", "properties": { "width": { "const": 1080 }, "height": { "const": 1920 } } }
      ]
    },
    "output": {
      "type": "object",
      "required": ["assetPath", "width", "height", "format", "sizeBytes", "sha256"],
      "properties": {
        "assetPath": {
          "type": "string",
          "pattern": "^frontend/src/assets/app-screenshots/real/(route-search|saved-journeys|journey-guidance|cross-operator-arrivals|predeparture-monitor)-(zh|en)-(540|720|1080)\\.webp$"
        },
        "width": { "type": "integer" },
        "height": { "type": "integer" },
        "format": { "const": "webp" },
        "sizeBytes": { "type": "integer", "minimum": 1 },
        "sha256": { "$ref": "#/$defs/sha256" }
      },
      "additionalProperties": false
    },
    "variant": {
      "type": "object",
      "required": [
        "sourceFileName",
        "sourceFingerprint",
        "outputs",
        "approvalStatus",
        "desensitizationStatus",
        "redactedItems",
        "retainedItems",
        "approvedAt"
      ],
      "properties": {
        "sourceFileName": {
          "type": "string",
          "minLength": 1,
          "pattern": "^(?!.*[\\\\/])(?!.*(?:Users|private|AndroidStudioProjects|sourcePath)).+$"
        },
        "sourceFingerprint": { "$ref": "#/$defs/sourceFingerprint" },
        "outputs": {
          "type": "array",
          "minItems": 3,
          "maxItems": 3,
          "prefixItems": [
            { "$ref": "#/$defs/output540" },
            { "$ref": "#/$defs/output720" },
            { "$ref": "#/$defs/output1080" }
          ],
          "items": false
        },
        "approvalStatus": { "const": "approved" },
        "desensitizationStatus": { "const": "approved" },
        "redactedItems": {
          "type": "array",
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/safeText" }
        },
        "retainedItems": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/safeText" }
        },
        "approvedAt": { "type": "string", "format": "date" }
      },
      "additionalProperties": false
    },
    "asset": {
      "type": "object",
      "required": ["id", "storyId", "order", "variants", "alt", "provenanceLabel"],
      "properties": {
        "id": { "type": "string" },
        "storyId": { "type": "string" },
        "order": { "type": "integer", "minimum": 1, "maximum": 5 },
        "variants": {
          "type": "object",
          "required": ["zh", "en"],
          "properties": {
            "zh": { "$ref": "#/$defs/variant" },
            "en": { "$ref": "#/$defs/variant" }
          },
          "additionalProperties": false
        },
        "alt": { "$ref": "#/$defs/localizedString" },
        "provenanceLabel": { "$ref": "#/$defs/safeText" }
      },
      "additionalProperties": false
    },
    "routeSearchAsset": {
      "allOf": [
        { "$ref": "#/$defs/asset" },
        { "type": "object", "properties": { "id": { "const": "route-search" }, "storyId": { "const": "route-search" }, "order": { "const": 1 } } }
      ]
    },
    "savedJourneysAsset": {
      "allOf": [
        { "$ref": "#/$defs/asset" },
        { "type": "object", "properties": { "id": { "const": "saved-journeys" }, "storyId": { "const": "saved-journeys" }, "order": { "const": 2 } } }
      ]
    },
    "journeyGuidanceAsset": {
      "allOf": [
        { "$ref": "#/$defs/asset" },
        { "type": "object", "properties": { "id": { "const": "journey-guidance" }, "storyId": { "const": "journey-guidance" }, "order": { "const": 3 } } }
      ]
    },
    "crossOperatorArrivalsAsset": {
      "allOf": [
        { "$ref": "#/$defs/asset" },
        { "type": "object", "properties": { "id": { "const": "cross-operator-arrivals" }, "storyId": { "const": "cross-operator-arrivals" }, "order": { "const": 4 } } }
      ]
    },
    "predepartureMonitorAsset": {
      "allOf": [
        { "$ref": "#/$defs/asset" },
        { "type": "object", "properties": { "id": { "const": "predeparture-monitor" }, "storyId": { "const": "predeparture-monitor" }, "order": { "const": 5 } } }
      ]
    }
  }
}
